# ─── Mínimo para correr en local (hackathon / clonar repo) ────────────────────
# Copia este archivo a `.env` y rellena NEXTAUTH_SECRET.
#
# Base de datos SQLite (archivo en /prisma/dev.db)
DATABASE_URL="file:./dev.db"

# NextAuth (obligatorio para sesión / login)
# Genera un secreto, p. ej.: openssl rand -base64 32
AUTH_SECRET="cambia-esto-por-un-secreto-largo-aleatorio"
NEXTAUTH_SECRET="cambia-esto-por-un-secreto-largo-aleatorio"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Opcional: correo (recuperar contraseña) ─────────────────────────────────
# Sin RESEND_API_KEY, en desarrollo el enlace de reset se imprime en la terminal.
# RESEND_API_KEY="re_..."
# RESEND_FROM_EMAIL="no-reply@tudominio.com"

# ─── Opcional: Redis (rate limiting); si falta, usa memoria en proceso ──────
# UPSTASH_REDIS_REST_URL="https://....upstash.io"
# UPSTASH_REDIS_REST_TOKEN="..."

# ─── Opcional: Supabase (el código actual no lo exige para desarrollo local) ─
# NEXT_PUBLIC_SUPABASE_URL="https://xxx.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="..."
# SUPABASE_SERVICE_ROLE_KEY="..."
# DIRECT_URL="..."  # solo si usas Prisma con Postgres remoto
